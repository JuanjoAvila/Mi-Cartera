<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Edge-to-edge: la WebView pinta bajo status/nav; el color lo pone el CSS (bg + safe-area). -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- ⚠ MITIGA, NO GARANTIZA CERRAR, lo que lleva reportando varias veces: «hace un efecto
             raro antes de aparecer el icono, como apagado». `windowDisablePreview` le dice a
             Android que NO use una miniatura/"starting window" auto-generada al reanudar la app
             desde el selector de apps o el multitarea — sin esto, Android puede enseñar un
             FOTOGRAMA VIEJO cacheado (con el atenuado/scrim que pinta el propio sistema durante
             la animación de "entrar" en la app) antes de que la WebView vuelva a pintar de
             verdad, que es justo el aspecto "apagado" que describe.
             Dicho esto: en MIUI/HyperOS (su móvil) el selector de apps tiene SU PROPIA animación
             de transición, ajena a esta app — ese atenuado puede venir de ahí y no ser 100 %
             evitable desde el código. Esto es el mejor mango disponible desde Android; si sigue
             pasando después de la APK nueva, es la animación del sistema operativo, no la app. -->
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>